{
  "name": "camera-clipboard",
  "private": true,
  "version": "0.1.0",
  "description": "Copy the current camera frame to the system Clipboard without persistent image storage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bem130/webcam-app.git"
  },
  "homepage": "https://bem130.github.io/webcam-app/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "generate:icons": "node scripts/generate-icons.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "npm run verify:e2e",
    "verify:repository": "node scripts/verify-repository.mjs",
    "verify:source": "npm run verify:repository && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify:e2e": "playwright test",
    "verify": "npm run verify:source && npm run verify:e2e"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
